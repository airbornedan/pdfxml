<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS hosting for fatwxsweb1 (site PDFXML, port 5055) via HttpPlatformHandler.
  Paths are absolute because this deployment is pinned to E:\PDFXML.
  Windows Authentication / anonymous-off are configured at the server level
  (applicationHost.config) by deploy/iis/setup-server.ps1, not here.
  Touching deploy\iis\restart.trigger restarts the app without admin rights.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="E:\PDFXML\.venv\Scripts\python.exe"
                  arguments="E:\PDFXML\deploy\iis\serve_iis.py"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="E:\PDFXML\logs\pdfxml">
      <environmentVariables>
        <environmentVariable name="PDFXML_TRUSTED_NETWORK" value="1" />
      </environmentVariables>
      <recycleOnFileChange>
        <file path="E:\PDFXML\deploy\iis\restart.trigger" />
      </recycleOnFileChange>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- Mirrors the app's 50MB MAX_UPLOAD_BYTES (bytes) -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
